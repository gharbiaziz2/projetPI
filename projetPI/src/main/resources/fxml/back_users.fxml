<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.gui.UsersController" spacing="16" styleClass="content-pane">
    <HBox styleClass="table-toolbar" alignment="CENTER_LEFT" spacing="12">
        <Button fx:id="btnAdd" text="+ Ajouter" styleClass="btn-primary" onAction="#onAdd"/>
        <Button fx:id="btnEdit" text="Modifier" styleClass="btn-secondary" onAction="#onEdit"/>
        <Button fx:id="btnDelete" text="Supprimer" styleClass="btn-danger" onAction="#onDelete"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Rechercher..." styleClass="search-field" prefWidth="220"/>
        <Button fx:id="btnFilter" text="Filtrage" styleClass="btn-filter" onAction="#onFilter"/>
    </HBox>
    <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="userTable" styleClass="table-view" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNom" text="Nom" prefWidth="100"/>
                <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="100"/>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="160"/>
                <TableColumn fx:id="colRole" text="Rôle" prefWidth="100"/>
                <TableColumn fx:id="colStatut" text="Statut" prefWidth="80"/>
                <TableColumn fx:id="colDateCreation" text="Date création" prefWidth="100"/>
                <TableColumn fx:id="colTelephone" text="Téléphone" prefWidth="100"/>
                <TableColumn fx:id="colAdresse" text="Adresse" prefWidth="140"/>
                <TableColumn fx:id="colPhoto" text="Photo" prefWidth="120"/>
                <TableColumn fx:id="colBio" text="Bio" prefWidth="140"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
