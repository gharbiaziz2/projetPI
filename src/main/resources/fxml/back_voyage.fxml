<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.gui.VoyageController" spacing="16" styleClass="content-pane">
    <HBox styleClass="table-toolbar" alignment="CENTER_LEFT" spacing="12">
        <Button fx:id="btnAdd" text="+ Ajouter" styleClass="btn-primary" onAction="#onAdd"/>
        <Button fx:id="btnEdit" text="Modifier" styleClass="btn-secondary" onAction="#onEdit"/>
        <Button fx:id="btnDelete" text="Supprimer" styleClass="btn-danger" onAction="#onDelete"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Rechercher..." styleClass="search-field" prefWidth="220"/>
        <RadioButton fx:id="rbAll" text="All" selected="true" onAction="#onFilter" styleClass="filter-radio">
            <toggleGroup>
                <ToggleGroup fx:id="filterGroup"/>
            </toggleGroup>
        </RadioButton>
        <RadioButton fx:id="rbVisible" text="Visible" onAction="#onFilter" styleClass="filter-radio">
            <toggleGroup>
                <fx:reference source="filterGroup"/>
            </toggleGroup>
        </RadioButton>
        <RadioButton fx:id="rbNonVisible" text="Non visible" onAction="#onFilter" styleClass="filter-radio">
            <toggleGroup>
                <fx:reference source="filterGroup"/>
            </toggleGroup>
        </RadioButton>
    </HBox>
    <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" styleClass="table-view" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colTypeVoyage" text="Nom" prefWidth="120"/>
                <TableColumn fx:id="colDateDepart" text="Date départ" prefWidth="100"/>
                <TableColumn fx:id="colDateRetour" text="Date retour" prefWidth="100"/>
                <TableColumn fx:id="colPrix" text="Prix" prefWidth="80"/>
                <TableColumn fx:id="colPlaces" text="Places" prefWidth="70"/>
                <TableColumn fx:id="colStatut" text="Statut" prefWidth="90"/>
                <TableColumn fx:id="colDestination" text="Destinations" prefWidth="160"/>
                <TableColumn fx:id="colActivites" text="Activités" prefWidth="160"/>
                <TableColumn fx:id="colIdGuide" text="Guide" prefWidth="70"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
