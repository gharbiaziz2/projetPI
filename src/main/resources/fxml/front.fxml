<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!-- prefWidth/Height removed — window size now drives layout (set maximized in App class) -->
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.gui.FrontController"
            maxWidth="Infinity" maxHeight="Infinity"
            stylesheets="@../css/front.css">
    <top>
        <HBox styleClass="front-navbar" alignment="CENTER_LEFT" spacing="16">
            <Button fx:id="btnHome" text="Accueil" styleClass="nav-btn" onAction="#goHome"/>
            <Button fx:id="btnVoyages" text="Voyages" styleClass="nav-btn" onAction="#goVoyages"/>
            <Button fx:id="btnActivites" text="Activités" styleClass="nav-btn" onAction="#goActivites"/>
            <Button fx:id="btnHotels" text="Hotels" styleClass="nav-btn" onAction="#goHotels"/>
            <Button fx:id="btnTransport" text="Transport" styleClass="nav-btn" onAction="#goTransport"/>
            <Button fx:id="btnForum" text="Forum" styleClass="nav-btn" onAction="#goForum"/>
            <Button fx:id="btnMyReservations" text="Mes réservations" styleClass="nav-btn" onAction="#goMyReservations"/>
            <Button fx:id="btnChatbot" text="Chatbot" styleClass="nav-btn" onAction="#goChatbot"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="userMenuButton" styleClass="user-menu-btn" onAction="#showUserMenu">
                <graphic>
                    <StackPane fx:id="avatarStack">
                        <ImageView fx:id="userAvatar" fitHeight="36" fitWidth="36" preserveRatio="true" styleClass="user-avatar"/>
                        <StackPane fx:id="avatarFallbackPane" styleClass="avatar-fallback" visible="false">
                            <Label fx:id="userAvatarFallback" text="?" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"/>
                        </StackPane>
                        <Label fx:id="notificationBadge" styleClass="notification-badge" visible="false"/>
                    </StackPane>
                </graphic>
            </Button>
        </HBox>
    </top>
    <center>
        <!-- maxWidth/maxHeight=Infinity ensures the StackPane stretches to fill all remaining space -->
        <StackPane fx:id="contentStack" styleClass="front-content"
                   maxWidth="Infinity" maxHeight="Infinity"
                   BorderPane.alignment="CENTER"/>
    </center>
</BorderPane>

