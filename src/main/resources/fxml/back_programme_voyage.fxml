<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.gui.ProgrammeVoyageController" spacing="16" styleClass="content-pane">
    <HBox styleClass="table-toolbar" alignment="CENTER_LEFT" spacing="12">
        <Button fx:id="btnAdd" text="+ Ajouter" styleClass="btn-primary" onAction="#onAdd"/>
        <Button fx:id="btnEdit" text="Modifier" styleClass="btn-secondary" onAction="#onEdit"/>
        <Button fx:id="btnDelete" text="Supprimer" styleClass="btn-danger" onAction="#onDelete"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Rechercher..." styleClass="search-field" prefWidth="220"/>
    </HBox>
    <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" styleClass="table-view" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colVoyage" text="Voyage" prefWidth="120"/>
                <TableColumn fx:id="colJour" text="Jour" prefWidth="60"/>
                <TableColumn fx:id="colTitre" text="Titre" prefWidth="140"/>
                <TableColumn fx:id="colDescription" text="Description" prefWidth="180"/>
                <TableColumn fx:id="colLieu" text="Lieu" prefWidth="120"/>
                <TableColumn fx:id="colHeureDebut" text="Début" prefWidth="80"/>
                <TableColumn fx:id="colHeureFin" text="Fin" prefWidth="80"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
