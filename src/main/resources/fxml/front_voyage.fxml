<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.gui.FrontVoyageController" spacing="16" styleClass="content-pane">
    <HBox styleClass="table-toolbar" alignment="CENTER_LEFT" spacing="12">
        <Label fx:id="lblUserName" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Rechercher..." styleClass="search-field" prefWidth="220"/>
    </HBox>
    
    <HBox spacing="10" styleClass="toolbar">
        <Button text="+ Proposer un voyage" styleClass="btn-primary" onAction="#onProposerVoyage"/>
        <Button text="Modifier" styleClass="btn-secondary" onAction="#onModifierProposition"/>
        <Button text="Supprimer" styleClass="btn-danger" onAction="#onSupprimerProposition"/>
        <Label text="(En attente = Modifiable | Accepté/Refusé = Final)" style="-fx-text-fill: #666; -fx-font-size: 11;"/>
    </HBox>
    
    <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="tablePropositions" styleClass="table-view" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colType" text="Type de voyage" prefWidth="180"/>
                <TableColumn fx:id="colDates" text="Dates" prefWidth="180"/>
                <TableColumn fx:id="colPrix" text="Prix" prefWidth="100"/>
                <TableColumn fx:id="colStatut" text="Statut" prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>
    
    <HBox styleClass="status-bar" spacing="20">
        <Label text="Légende:"/>
        <HBox spacing="5" style="-fx-padding: 5; -fx-border-color: #d4edda; -fx-background-color: #d4edda;">
            <Label text="ACCEPTÉ" style="-fx-text-fill: #155724;"/>
        </HBox>
        <HBox spacing="5" style="-fx-padding: 5; -fx-border-color: #fff3cd; -fx-background-color: #fff3cd;">
            <Label text="EN ATTENTE" style="-fx-text-fill: #856404;"/>
        </HBox>
        <HBox spacing="5" style="-fx-padding: 5; -fx-border-color: #f8d7da; -fx-background-color: #f8d7da;">
            <Label text="REFUSÉ" style="-fx-text-fill: #721c24;"/>
        </HBox>
    </HBox>
</VBox>
